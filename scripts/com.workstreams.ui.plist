<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.workstreams.ui</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"; exec ws-ui</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/workstreams-ui.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/workstreams-ui.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>SHUNT_MIN_LINES</key>
        <string>350</string>
    </dict>
</dict>
</plist>

